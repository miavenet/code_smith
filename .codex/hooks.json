{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/statusline.py\" --hook",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
