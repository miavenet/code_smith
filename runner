#!/usr/bin/env python3
"""Entry point of code_smith. No install step: run it from a checkout."""

import os
import sys

# Before any import that needs it (tomllib is 3.11): an older Python gets one plain sentence.
if sys.version_info < (3, 11):
    sys.stderr.write("code_smith needs Python 3.11 or newer (found %d.%d.%d)\n" % tuple(sys.version_info[:3]))
    sys.exit(2)

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "src"))

from codesmith.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
